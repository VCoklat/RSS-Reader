# Vercel Postgres — populate via `vercel link` + `vercel env pull`
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Google AI Studio API key (Gemini/Gemma access)
GEMINI_API_KEY=
GEMINI_MODEL=gemma-3-27b-it

# Shared secret checked against the Authorization header on cron requests.
# Vercel automatically sends this as "Bearer $CRON_SECRET" for Cron Jobs.
CRON_SECRET=
